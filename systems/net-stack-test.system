<?xml version="1.0" encoding="UTF-8"?>
<!--
    In QEMU: the network stack
    PD runs smoltcp over the virtio-net driver's queues and takes a DHCP
    lease from QEMU's user-mode network.

        timer         monotonic time, as in timer-demo: the stack's only time
        virtio_net    the NIC driver PD of net-test, unchanged
        seed_source a test PD in the entropy PD's place:
                      writes one fixed test seed on the stack's seed ring
        net_stack     takes its seed, brings its interface up at the card's
                      MAC address and asks for a lease; QEMU's DHCP server
                      gives it 10.0.2.15/24, gateway 10.0.2.2

    net-stack-test.qemu leaves QEMU's user-mode network unrestricted
    (restrict=off), unlike net-test.qemu: QEMU's DHCP server names the
    gateway only then (AC 2). The stack has no socket but its DHCP client,
    so its frames reach only QEMU's DHCP server and ARP.

    QEMU only: the timer PD is woken by the CPU's timer, which Microkit
    exports to user level on QEMU (phys_timer), and the Pi 5's Ethernet is
    RP1's, behind PCIe.

    Capabilities: the driver's, exactly as in net-test. The stack (role
    network) holds no device, interrupt or physical address: it maps the four
    queues read-write, as sDDF's layout has each side write its own index,
    the receive buffers read-only and its transmit buffers read-write, 128
    buffers of 2048 bytes each (nowayos-net's DATA_REGION_LEN;
    tools/test_tools.py checks the sizes), and its end of the seed ring - the
    control region read-write, the seed read-only. It calls the timer, which
    notifies it when its timeout expires, and is notified by the driver and
    by seed_source, which it never notifies. seed_source maps the other ends
    of the seed ring and has no other channel. Each PD the stack calls or
    waits on first runs above it: the timer, the driver, then seed_source.

    Every grant above is also listed in net-stack-test.grants, which
    tools/check-system compares with this file and with the kernel objects
    the Microkit tool generates (make image, make qemu-test).
-->
<system>
    <memory_region name="virtio_regs" size="@virtio_mmio_24_31" phys_addr="@virtio_mmio_24_31" />
    <memory_region name="rx_ring" size="0x3000" />
    <memory_region name="tx_ring" size="0x3000" />
    <memory_region name="rx_buffers" size="0x40000" />
    <memory_region name="tx_buffers" size="0x40000" />
    <memory_region name="rx_free" size="0x1000" />
    <memory_region name="rx_active" size="0x1000" />
    <memory_region name="tx_free" size="0x1000" />
    <memory_region name="tx_active" size="0x1000" />
    <!-- The stack's seed ring: the seed (seed_source's), control (the stack's). -->
    <memory_region name="seed_ring" size="0x1000" />
    <memory_region name="seed_ring_control" size="0x1000" />

    <protection_domain name="timer" priority="220" stack_size="0x10000">
        <program_image path="nowayos-timer.elf" />
        <irq irq="@phys_timer" id="0" trigger="@phys_timer" />
    </protection_domain>

    <protection_domain name="virtio_net" priority="200" stack_size="0x10000">
        <program_image path="nowayos-virtio-net.elf" />
        <map mr="virtio_regs" vaddr="0x200_0000" perms="rw" cached="false"
             setvar_vaddr="nowayos_device_0_vaddr" setvar_size="nowayos_device_0_size" />
        <map mr="rx_ring" vaddr="0x300_0000" perms="rw" cached="false"
             setvar_vaddr="nowayos_dma_0_vaddr" setvar_size="nowayos_dma_0_size" />
        <map mr="tx_ring" vaddr="0x300_4000" perms="rw" cached="false"
             setvar_vaddr="nowayos_dma_1_vaddr" setvar_size="nowayos_dma_1_size" />
        <setvar symbol="nowayos_dma_0_paddr" region_paddr="rx_ring" />
        <setvar symbol="nowayos_dma_1_paddr" region_paddr="tx_ring" />
        <!-- The stack's buffers, by physical address only: never mapped here. -->
        <setvar symbol="nowayos_io_0_paddr" region_paddr="rx_buffers" />
        <setvar symbol="nowayos_io_1_paddr" region_paddr="tx_buffers" />
        <map mr="rx_free" vaddr="0x4000_0000" perms="rw"
             setvar_vaddr="nowayos_rw_region_0_vaddr" setvar_size="nowayos_rw_region_0_size" />
        <map mr="rx_active" vaddr="0x4000_1000" perms="rw"
             setvar_vaddr="nowayos_rw_region_1_vaddr" setvar_size="nowayos_rw_region_1_size" />
        <map mr="tx_free" vaddr="0x4000_2000" perms="rw"
             setvar_vaddr="nowayos_rw_region_2_vaddr" setvar_size="nowayos_rw_region_2_size" />
        <map mr="tx_active" vaddr="0x4000_3000" perms="rw"
             setvar_vaddr="nowayos_rw_region_3_vaddr" setvar_size="nowayos_rw_region_3_size" />
        <irq irq="@virtio_mmio_24_31[7]" id="1" trigger="@virtio_mmio_24_31" />
    </protection_domain>

    <protection_domain name="seed_source" priority="150" stack_size="0x10000">
        <program_image path="nowayos-net-stack-test.elf" />
        <map mr="seed_ring" vaddr="0x4000_0000" perms="rw"
             setvar_vaddr="nowayos_rw_region_0_vaddr" setvar_size="nowayos_rw_region_0_size" />
        <map mr="seed_ring_control" vaddr="0x4000_1000" perms="r"
             setvar_vaddr="nowayos_ro_region_0_vaddr" setvar_size="nowayos_ro_region_0_size" />
    </protection_domain>

    <protection_domain name="net_stack" priority="100" stack_size="0x80000">
        <program_image path="nowayos-net-stack.elf" />
        <map mr="rx_free" vaddr="0x4000_0000" perms="rw"
             setvar_vaddr="nowayos_rw_region_0_vaddr" setvar_size="nowayos_rw_region_0_size" />
        <map mr="rx_active" vaddr="0x4000_1000" perms="rw"
             setvar_vaddr="nowayos_rw_region_1_vaddr" setvar_size="nowayos_rw_region_1_size" />
        <map mr="tx_free" vaddr="0x4000_2000" perms="rw"
             setvar_vaddr="nowayos_rw_region_2_vaddr" setvar_size="nowayos_rw_region_2_size" />
        <map mr="tx_active" vaddr="0x4000_3000" perms="rw"
             setvar_vaddr="nowayos_rw_region_3_vaddr" setvar_size="nowayos_rw_region_3_size" />
        <map mr="rx_buffers" vaddr="0x5000_0000" perms="r"
             setvar_vaddr="nowayos_ro_region_0_vaddr" setvar_size="nowayos_ro_region_0_size" />
        <map mr="tx_buffers" vaddr="0x5100_0000" perms="rw"
             setvar_vaddr="nowayos_rw_region_4_vaddr" setvar_size="nowayos_rw_region_4_size" />
        <map mr="seed_ring_control" vaddr="0x4000_4000" perms="rw"
             setvar_vaddr="nowayos_rw_region_5_vaddr" setvar_size="nowayos_rw_region_5_size" />
        <map mr="seed_ring" vaddr="0x4000_5000" perms="r"
             setvar_vaddr="nowayos_ro_region_1_vaddr" setvar_size="nowayos_ro_region_1_size" />
    </protection_domain>

    <!-- The driver and the stack notify each other. -->
    <channel>
        <end pd="virtio_net" id="0" />
        <end pd="net_stack" id="0" />
    </channel>
    <!-- The stack calls the timer, which notifies it of its timeout. -->
    <channel>
        <end pd="net_stack" id="1" pp="true" notify="false" />
        <end pd="timer" id="1" />
    </channel>
    <!-- seed_source notifies the stack when a seed waits. -->
    <channel>
        <end pd="seed_source" id="0" />
        <end pd="net_stack" id="2" notify="false" />
    </channel>
</system>
