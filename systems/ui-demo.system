<?xml version="1.0" encoding="UTF-8"?>
<!--
    The clickable demo in QEMU. The UI runs in its
    own PD, drawing into a framebuffer a display PD reads. The display here
    is a stub: it announces the Pi 5's window at its own pixels, 1920x1080
    r5g6b5 at device scale 2 - a 960x540 screen drawn crisp -
    checks each Present, hashes the frame and acknowledges it. An input PD plays the host demo's
    scripted session to the UI as canonical InputEvent records, one step per
    frame, with one malformed record the UI must reject. ui-demo.expect holds
    the hashes of the approved golden images of every step
    (crates/nowayos-demo/session/), so one pixel drawn differently fails the
    test.

    Two rings carry the display contract, each over two regions so that each side writes only what it
    owns; and the framebuffer is read-write in the UI, read-only in the
    display. Neither PD has a device, an interrupt or a child: the UI's role
    is ui, the stub's display (tools/grant-rules.toml).

        present_messages   UI rw, display r   Present records
        present_control    display rw, UI r   the display's index
        display_messages   display rw, UI r   Configure, PresentDone
        display_control    UI rw, display r   the UI's index
        framebuffer        UI rw, display r   4 MiB: 4,085,760 bytes of pixels
        input_messages     input rw, UI r     InputEvent records
        input_control      UI rw, input r     the UI's index

    The display runs above the input PD, and the input PD above the UI: a
    busy UI can hold up neither the screen nor input. The input PD's role is
    input; it holds no device. Every grant is also listed in ui-demo.grants.
-->
<system>
    <memory_region name="present_messages" size="0x1000" />
    <memory_region name="present_control" size="0x1000" />
    <memory_region name="display_messages" size="0x1000" />
    <memory_region name="display_control" size="0x1000" />
    <memory_region name="framebuffer" size="0x400000" />
    <memory_region name="input_messages" size="0x1000" />
    <memory_region name="input_control" size="0x1000" />

    <protection_domain name="display" priority="3" stack_size="0x10000">
        <program_image path="nowayos-display-stub.elf" />
        <map mr="present_control" vaddr="0x4000_0000" perms="rw"
             setvar_vaddr="nowayos_rw_region_0_vaddr" setvar_size="nowayos_rw_region_0_size" />
        <map mr="present_messages" vaddr="0x4000_1000" perms="r"
             setvar_vaddr="nowayos_ro_region_0_vaddr" setvar_size="nowayos_ro_region_0_size" />
        <map mr="display_messages" vaddr="0x4000_2000" perms="rw"
             setvar_vaddr="nowayos_rw_region_1_vaddr" setvar_size="nowayos_rw_region_1_size" />
        <map mr="display_control" vaddr="0x4000_3000" perms="r"
             setvar_vaddr="nowayos_ro_region_1_vaddr" setvar_size="nowayos_ro_region_1_size" />
        <map mr="framebuffer" vaddr="0x5000_0000" perms="r"
             setvar_vaddr="nowayos_ro_region_2_vaddr" setvar_size="nowayos_ro_region_2_size" />
    </protection_domain>

    <protection_domain name="ui" priority="1" stack_size="0x20000">
        <program_image path="nowayos-ui-demo.elf" />
        <map mr="present_messages" vaddr="0x4000_0000" perms="rw"
             setvar_vaddr="nowayos_rw_region_0_vaddr" setvar_size="nowayos_rw_region_0_size" />
        <map mr="present_control" vaddr="0x4000_1000" perms="r"
             setvar_vaddr="nowayos_ro_region_0_vaddr" setvar_size="nowayos_ro_region_0_size" />
        <map mr="display_control" vaddr="0x4000_2000" perms="rw"
             setvar_vaddr="nowayos_rw_region_1_vaddr" setvar_size="nowayos_rw_region_1_size" />
        <map mr="display_messages" vaddr="0x4000_3000" perms="r"
             setvar_vaddr="nowayos_ro_region_1_vaddr" setvar_size="nowayos_ro_region_1_size" />
        <map mr="framebuffer" vaddr="0x5000_0000" perms="rw"
             setvar_vaddr="nowayos_rw_region_2_vaddr" setvar_size="nowayos_rw_region_2_size" />
        <map mr="input_control" vaddr="0x4000_4000" perms="rw"
             setvar_vaddr="nowayos_rw_region_3_vaddr" setvar_size="nowayos_rw_region_3_size" />
        <map mr="input_messages" vaddr="0x4000_5000" perms="r"
             setvar_vaddr="nowayos_ro_region_2_vaddr" setvar_size="nowayos_ro_region_2_size" />
    </protection_domain>

    <protection_domain name="input" priority="2" stack_size="0x10000">
        <program_image path="nowayos-input-script.elf" />
        <map mr="input_messages" vaddr="0x4000_0000" perms="rw"
             setvar_vaddr="nowayos_rw_region_0_vaddr" setvar_size="nowayos_rw_region_0_size" />
        <map mr="input_control" vaddr="0x4000_1000" perms="r"
             setvar_vaddr="nowayos_ro_region_0_vaddr" setvar_size="nowayos_ro_region_0_size" />
    </protection_domain>

    <!-- "Records waiting", both ways. -->
    <channel>
        <end pd="ui" id="0" />
        <end pd="display" id="0" />
    </channel>

    <!-- "Events waiting" from the input PD; "ready for more" from the UI. -->
    <channel>
        <end pd="ui" id="1" />
        <end pd="input" id="0" />
    </channel>
</system>
