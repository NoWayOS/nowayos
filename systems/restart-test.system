<?xml version="1.0" encoding="UTF-8"?>
<!--
    restarting one PD cleanly. worker serves client
    over two rings, requests in and answers out. When a crash request makes
    worker panic, as a PD does on input it cannot handle, its parent,
    restarter, restarts it at its restart entry (nowayos-restart), and the
    entry puts back worker's writable memory from its restart image before
    rust-sel4's runtime starts: worker's init runs on .data and .bss as the
    program was loaded, and the runtime's once-only set-up runs afresh. Its
    new restart epoch tells client it restarted; client sends again the
    work that was not answered, but not the ticks or the crash request that
    were in flight, and worker answers it.

    worker's restart image is made from its program when the system image is
    built (tools/restart-image) and mapped read-only into worker and into its
    parent, which reads the restart entry and stack pointer from it
    (tools/check-system rules 12 and 13). Restarting one PD on its own is
    for test systems only: no product system may have a restart image.

    Capabilities: restarter holds worker's thread capability and faults (as
    its parent) and maps worker's restart image, read-only. worker maps its
    restart image read-only and its ends of the two rings - the control of
    the request ring and the messages of the answer ring read-write, the
    other two read-only - and client the other ends; worker and client share
    one channel.

    Every grant above is also listed in restart-test.grants, which
    tools/check-system compares with this file and with the kernel objects
    the Microkit tool generates (make image, make qemu-test).
-->
<system>
    <!-- worker's restart image: its writable memory as its program is loaded. -->
    <memory_region name="worker_restart" size="0x1000" prefill_path="restart-worker.bin" />

    <!-- The request ring, client to worker: messages (client's), control (worker's). -->
    <memory_region name="requests" size="0x1000" />
    <memory_region name="requests_control" size="0x1000" />

    <!-- The answer ring, worker to client: messages (worker's), control (client's). -->
    <memory_region name="answers" size="0x1000" />
    <memory_region name="answers_control" size="0x1000" />

    <protection_domain name="restarter" priority="254" stack_size="0x10000">
        <program_image path="nowayos-restart-probe.elf" />
        <map mr="worker_restart" vaddr="0x5000_0000" perms="r"
             setvar_vaddr="nowayos_ro_region_0_vaddr" setvar_size="nowayos_ro_region_0_size" />

        <protection_domain name="worker" id="0" priority="100" stack_size="0x10000">
            <program_image path="nowayos-restart-probe.elf" />
            <map mr="worker_restart" vaddr="0x5000_0000" perms="r"
                 setvar_vaddr="nowayos_restart_image_vaddr" setvar_size="nowayos_restart_image_size" />
            <map mr="requests_control" vaddr="0x4000_0000" perms="rw"
                 setvar_vaddr="nowayos_rw_region_0_vaddr" setvar_size="nowayos_rw_region_0_size" />
            <map mr="requests" vaddr="0x4000_1000" perms="r"
                 setvar_vaddr="nowayos_ro_region_0_vaddr" setvar_size="nowayos_ro_region_0_size" />
            <map mr="answers" vaddr="0x4000_2000" perms="rw"
                 setvar_vaddr="nowayos_rw_region_1_vaddr" setvar_size="nowayos_rw_region_1_size" />
            <map mr="answers_control" vaddr="0x4000_3000" perms="r"
                 setvar_vaddr="nowayos_ro_region_1_vaddr" setvar_size="nowayos_ro_region_1_size" />
        </protection_domain>
    </protection_domain>

    <protection_domain name="client" priority="50" stack_size="0x10000">
        <program_image path="nowayos-restart-probe.elf" />
        <map mr="requests" vaddr="0x4000_0000" perms="rw"
             setvar_vaddr="nowayos_rw_region_0_vaddr" setvar_size="nowayos_rw_region_0_size" />
        <map mr="requests_control" vaddr="0x4000_1000" perms="r"
             setvar_vaddr="nowayos_ro_region_0_vaddr" setvar_size="nowayos_ro_region_0_size" />
        <map mr="answers_control" vaddr="0x4000_2000" perms="rw"
             setvar_vaddr="nowayos_rw_region_1_vaddr" setvar_size="nowayos_rw_region_1_size" />
        <map mr="answers" vaddr="0x4000_3000" perms="r"
             setvar_vaddr="nowayos_ro_region_1_vaddr" setvar_size="nowayos_ro_region_1_size" />
    </protection_domain>

    <!-- worker and client notify each other. -->
    <channel>
        <end pd="worker" id="0" />
        <end pd="client" id="0" />
    </channel>
</system>
