<?xml version="1.0" encoding="UTF-8"?>
<!--
    Time isolation shown, not assumed. A PD that never
    stops, held to its budget, leaves the PD below it its time.

        timer      the timer PD: the heartbeat's timeouts, woken by the
                   CPU's timer
        looper     above the heartbeat, with a budget of 2 ms in every
                   10 ms; told to start after the third beat, it loops for
                   ever, and the kernel stops it at its budget each period
        heartbeat  beats every 100 ms on the timer and says whether each
                   beat came on time: every one does

    budget-test-widened.system is this system with the looper's budget
    widened to its period, and nothing else (make tools-test checks): the
    looper then starves the heartbeat, which stops.

    Both run nowayos-budget-probe, a test instrument, as looper and
    heartbeat. No PD holds a device but the timer, which holds its
    interrupt; the heartbeat calls the timer and notifies the looper; the
    looper holds that channel alone.

    QEMU only: the timer PD is woken by the CPU's timer, which Microkit
    exports to user level on QEMU (phys_timer).

    Every grant above is also listed in budget-test.grants, which
    tools/check-system compares with this file and with the kernel objects
    the Microkit tool generates (make image, make qemu-test).
-->
<system>
    <protection_domain name="timer" priority="200" stack_size="0x10000">
        <program_image path="nowayos-timer.elf" />
        <irq irq="@phys_timer" id="0" trigger="@phys_timer" />
    </protection_domain>

    <protection_domain name="looper" priority="150" budget="2000" period="10000" stack_size="0x10000">
        <program_image path="nowayos-budget-probe.elf" />
    </protection_domain>

    <protection_domain name="heartbeat" priority="100" stack_size="0x10000">
        <program_image path="nowayos-budget-probe.elf" />
    </protection_domain>

    <!-- The heartbeat calls the timer; the timer notifies it of expiries. -->
    <channel>
        <end pd="heartbeat" id="0" pp="true" notify="false" />
        <end pd="timer" id="1" />
    </channel>

    <!-- "Start looping": the heartbeat to the looper. -->
    <channel>
        <end pd="heartbeat" id="1" />
        <end pd="looper" id="0" notify="false" />
    </channel>
</system>
