# Everything systems/virtio-input-test.system grants, one fact per line.
# tools/check-system fails the build if the system description grants anything
# not listed here, or lists anything it does not grant, and checks the map
# rights again in the kernel objects the Microkit tool generates (format: see
# tools/check-system). A change here is a security change: call it out in the
# pull request.

# The kind of system, and each PD's role (tools/grant-rules.toml).
system test
role virtio_input input
role input_print test

# The driver runs above its consumer, so a burst it sends fills the ring
# before the consumer drains it (the test's ring-full case). Full budgets.
pd virtio_input priority=200 budget=1000 period=1000
pd input_print priority=100 budget=1000 period=1000

# One page of virtio-mmio transports, by name from the board file: uncached,
# this PD only; and the interrupts of transports 30 (the tablet) and 31 (the
# keyboard).
device virtio_input virtio_mmio_24_31 rw
irq virtio_input virtio_mmio_24_31 78
irq virtio_input virtio_mmio_24_31 79

# Each device's event queue - descriptors, rings and buffers - which the
# device reads and writes by DMA.
map virtio_input tablet_events rw
paddr virtio_input tablet_events
map virtio_input keyboard_events rw
paddr virtio_input keyboard_events

# Configuration: the screen's size (800x480), read-only.
map virtio_input screen r

# A ring per device to the test consumer - the pointer ring and the keyboard
# ring: messages written by the driver only, the consumer's index written by
# the consumer only.
map virtio_input pointer_messages rw
map virtio_input pointer_control r
map virtio_input keyboard_messages rw
map virtio_input keyboard_control r
map input_print pointer_control rw
map input_print pointer_messages r
map input_print keyboard_control rw
map input_print keyboard_messages r
channel input_print virtio_input notify=virtio_input
