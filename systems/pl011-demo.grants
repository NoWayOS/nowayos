# Everything systems/pl011-demo.system grants, one fact per line.
# tools/check-system fails the build if the system description grants anything
# not listed here, or lists anything it does not grant, and checks the map
# rights again in the kernel objects the Microkit tool generates (format: see
# tools/check-system). A change here is a security change: call it out in the
# pull request.

# The kind of system, and each PD's role (tools/grant-rules.toml).
system demo
role pl011 driver

pd pl011 priority=1 budget=1000 period=1000

# The UART's registers, by name from the board file: uncached, this PD only.
device pl011 debug_uart rw

# The board's facts about the UART (device-debug_uart.bin): which
# PL011 it is and how many bytes of its page are registers. Configuration,
# read-only.
map pl011 debug_uart_facts r
