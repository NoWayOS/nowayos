# Input ui-interactive's QEMU receives over QMP (tools/qemu-test,
# --qmp-script): the host demo's scripted session (crates/nowayos-demo,
# SESSION), step by step, with QEMU's keyboard and tablet. After each step it
# waits until the display shows the step's approved golden image - by its
# hash, which crates/nowayos-demo/tests/frame_hash.rs computes from the image
# - then compares QEMU's screen with that image, pixel for pixel. A tap in
# the session is a click here: the UI handles both alike.
tablet 1920 1080

# 00 start: the first frame.
wait NOWAYOS: display: showing 0x0ee912d0f2a5615f
screen ../crates/nowayos-demo/session/00-start.png

# 01 tap-outside: nowhere a control is.
click 960 600
wait NOWAYOS: display: showing 0x0ee912d0f2a5615f
screen ../crates/nowayos-demo/session/01-tap-outside.png

# 02 keys-unfocused: keys with nothing focused change nothing.
key q ret
wait NOWAYOS: display: showing 0x0ee912d0f2a5615f
screen ../crates/nowayos-demo/session/02-keys-unfocused.png

# 03 click-name: focus the name; the pointer rests on it, hovering it.
click 400 260
wait NOWAYOS: display: showing 0x6c594f280b8b355a
screen ../crates/nowayos-demo/session/03-click-name.png

# 04 type-name: "Ada", the A with shift held.
hold shift
key a
release shift
key d a
wait NOWAYOS: display: showing 0xde044e2bc9b442f8
screen ../crates/nowayos-demo/session/04-type-name.png

# 05 type-into-full: 62 more letters; the last is refused, the input full.
key x x x x x x x x x x x x x x x x x x x x x x x x x x x x x x x x x x x x x x x x x x x x x x x x x x x x x x x x x x x x x x
wait NOWAYOS: display: showing 0xb16f3bea36c04c2f
screen ../crates/nowayos-demo/session/05-type-into-full.png

# 06 click-help.
click 120 970
wait NOWAYOS: display: showing 0xa1939e18dfb0c8c9
screen ../crates/nowayos-demo/session/06-click-help.png

# 07 click-continue.
click 1750 970
wait NOWAYOS: display: showing 0xd4775af2d7df6ca4
screen ../crates/nowayos-demo/session/07-click-continue.png

# 08 keys-on-done: change nothing.
key q ret
wait NOWAYOS: display: showing 0xd4775af2d7df6ca4
screen ../crates/nowayos-demo/session/08-keys-on-done.png

# 09 tap-start-again: back to the start, the form empty.
click 180 970
wait NOWAYOS: display: showing 0x0ee912d0f2a5615f
screen ../crates/nowayos-demo/session/09-tap-start-again.png

# 10 type-accents: the name focused again, and "Zoë Siobhán £5" typed on the
# demo's UK layout - AltGr+2 a dead diaeresis, AltGr+a an á, Shift+3 a £ -
# through the virtio keyboard and the input broker.
click 400 260
hold shift
key z
release shift
key o
hold alt_r
key 2
release alt_r
key e spc
hold shift
key s
release shift
key i o b h
hold alt_r
key a
release alt_r
key n spc
hold shift
key 3
release shift
key 5
wait NOWAYOS: display: showing 0x49a33d551f0c65cb
screen ../crates/nowayos-demo/session/10-type-accents.png
