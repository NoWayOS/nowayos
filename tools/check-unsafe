#!/usr/bin/env python3
# SPDX-License-Identifier: MIT OR Apache-2.0
"""The `unsafe` audit: keep "where is all the unsafe code?" answerable.

Usage:
    check-unsafe [--root DIR] [--allowlist FILE | --no-allowlist]
    check-unsafe [...] --miri-crates WORKSPACE   print the crates to run Miri on

Checks a repository laid out like nowayos's - a Cargo workspace at its root
and one in pds/ - (DIR, default: the nowayos repository, the directory above
tools/) against the approved-unsafe list (FILE, default
tools/unsafe-allowlist.toml; its header describes the rules). With
--no-allowlist no crate is approved: no `unsafe` anywhere (a product repo
with none of its own). Fails (exit 1) if `unsafe` code, or an
attribute relaxing the `unsafe_code` lint, appears in a file the list does
not name; if a listed file no longer contains any; if a crate outside the
list does not take its workspace's lints, or the workspace lints do not
forbid `unsafe_code`; or if a listed crate's own lints are weaker than its
workspace's.

Comments, strings and character literals are skipped, so documentation
that mentions `unsafe` does not count; code generated by macros from other
crates is not seen (only this repository's source is read).

It also refuses a getrandom back end anywhere but nowayos-entropy: getrandom 0.2's `register_custom_getrandom!`, whose
#[no_mangle] the unsafe check cannot see, and either back-end symbol,
`__getrandom_custom` or `__getrandom_v03_custom`, named in any .rs file
outside nowayos-entropy's crate - in code or in a string, comments aside.
A product repo, with no nowayos-entropy of its own, may name none of them.
std-crates-check's link check covers third-party crates, whose source this
never reads.

Exit status: 0 pass; 1 a check failed; 2 usage or input error.
Python 3.11 or later (tomllib), standard library only.
"""

import argparse
import os
import re
import sys

try:
    import tomllib
except ModuleNotFoundError:  # Python before 3.11
    tomllib = None

EXIT_PASS = 0
EXIT_FAIL = 1
EXIT_ERROR = 2

# The two Cargo workspaces: name -> manifest, relative to the repository.
WORKSPACES = {"root": "Cargo.toml", "pds": "pds/Cargo.toml"}
SKIP_DIRS = {".git", "target", "build", "node_modules"}

UNSAFE_KEYWORD = re.compile(r"\bunsafe\b")
GETRANDOM_BACKEND = re.compile(r"\b(?:register_custom_getrandom|__getrandom_custom|__getrandom_v03_custom)\b")
ENTROPY_CRATE = "nowayos-entropy"
RELAXING_ATTRIBUTE = re.compile(r"\b(?:allow|expect|warn)\s*\([^()]*\bunsafe_code\b")
RAW_STRING = re.compile(r'(?:b|c)?r(#*)"')
CHAR_LITERAL = re.compile(r"'(?:\\(?:x[0-9a-fA-F]{2}|u\{[0-9a-fA-F_]{1,6}\}|.)|[^\\'\n])'")
LEVELS = {"allow": 0, "expect": 0, "warn": 1, "deny": 2, "forbid": 3}


class InputError(Exception):
    """A file could not be read or parsed."""


def code_only(source):
    """`source` with comments and the contents of string and character
    literals blanked out, so only code remains to search."""
    out = []
    i, n = 0, len(source)
    while i < n:
        if source.startswith("//", i):
            end = source.find("\n", i)
            i = n if end < 0 else end
            continue
        if source.startswith("/*", i):
            depth, i = 1, i + 2
            while i < n and depth:
                if source.startswith("/*", i):
                    depth, i = depth + 1, i + 2
                elif source.startswith("*/", i):
                    depth, i = depth - 1, i + 2
                else:
                    i += 1
            out.append(" ")
            continue
        previous = source[i - 1] if i else " "
        identifier_before = previous.isalnum() or previous == "_"
        raw = RAW_STRING.match(source, i)
        if raw and not identifier_before:
            closing = '"' + raw.group(1)
            end = source.find(closing, raw.end())
            i = n if end < 0 else end + len(closing)
            out.append('""')
            continue
        char = source[i]
        if char == '"':
            i += 1
            while i < n and source[i] != '"':
                i += 2 if source[i] == "\\" else 1
            i += 1
            out.append('""')
            continue
        if char == "'":
            literal = CHAR_LITERAL.match(source, i)
            if literal:
                i = literal.end()
                out.append("' '")
                continue
        out.append(char)
        i += 1
    return "".join(out)


def unsafe_uses(path):
    """The (line, what) places in a Rust file that use or allow unsafe code."""
    try:
        with open(path, encoding="utf-8") as handle:
            code = code_only(handle.read())
    except (OSError, UnicodeDecodeError) as err:
        raise InputError(f"cannot read {path}: {err}") from err
    found = []
    for pattern, what in ((UNSAFE_KEYWORD, "`unsafe`"), (RELAXING_ATTRIBUTE, "unsafe_code allowed")):
        for match in pattern.finditer(code):
            found.append((code.count("\n", 0, match.start()) + 1, what))
    return sorted(found)


def load_toml(path):
    try:
        with open(path, "rb") as handle:
            return tomllib.load(handle)
    except (OSError, tomllib.TOMLDecodeError) as err:
        raise InputError(f"cannot read {path}: {err}") from err


def level(value):
    """A lint's level, from `"deny"` or `{ level = "deny", priority = 1 }`."""
    if isinstance(value, dict):
        value = value.get("level")
    return value if value in LEVELS else None


def members(root, workspace_manifest):
    """The member crates of a workspace: (package name, manifest path)."""
    manifest = load_toml(os.path.join(root, workspace_manifest))
    base = os.path.dirname(os.path.join(root, workspace_manifest))
    found = []
    for pattern in manifest.get("workspace", {}).get("members", []):
        if pattern.endswith("/*"):
            parent = os.path.join(base, pattern[:-2])
            dirs = sorted(os.path.join(parent, d) for d in os.listdir(parent))
        else:
            dirs = [os.path.join(base, pattern)]
        for directory in dirs:
            path = os.path.join(directory, "Cargo.toml")
            if os.path.isfile(path):
                found.append((load_toml(path)["package"]["name"], path))
    return manifest, found


def lint_problems(root, allowlist):
    """Workspace and crate lint tables (see the module documentation)."""
    problems = []
    listed = {entry["name"]: entry for entry in allowlist}
    seen = set()
    for workspace, workspace_manifest in WORKSPACES.items():
        manifest, crates = members(root, workspace_manifest)
        lints = manifest.get("workspace", {}).get("lints", {})
        if level(lints.get("rust", {}).get("unsafe_code")) != "forbid":
            problems.append(f"{workspace_manifest}: [workspace.lints.rust] must set unsafe_code = \"forbid\"")
        for name, path in crates:
            relative = os.path.relpath(path, root)
            crate_lints = load_toml(path).get("lints", {})
            entry = listed.get(name)
            if entry is None:
                if crate_lints != {"workspace": True}:
                    problems.append(
                        f"{relative}: crate {name!r} is not on the approved-unsafe list, so it "
                        f"must take the workspace lints and nothing else: `[lints] workspace = true`"
                    )
                continue
            seen.add(name)
            if entry.get("workspace") != workspace:
                problems.append(f"{relative}: {name!r} is in the {workspace!r} workspace, the list says {entry.get('workspace')!r}")
            if crate_lints.get("workspace"):
                problems.append(f"{relative}: {name!r} is approved for unsafe code, so it cannot inherit lints that forbid it; copy them with unsafe_code = \"deny\"")
                continue
            for table in ("rust", "clippy"):
                wanted = lints.get(table, {})
                have = crate_lints.get(table, {})
                for lint, value in wanted.items():
                    need = "deny" if (table, lint) == ("rust", "unsafe_code") else level(value)
                    got = level(have.get(lint))
                    if got != need:
                        problems.append(f"{relative}: [lints.{table}] {lint} must be {need!r} (workspace: {level(value)!r}), not {got!r}")
                for lint, value in have.items():
                    if lint not in wanted and LEVELS.get(level(value), 0) < LEVELS["deny"]:
                        problems.append(f"{relative}: [lints.{table}] {lint} may only add deny or forbid lints")
    for name in sorted(set(listed) - seen):
        problems.append(f"the approved-unsafe list names {name!r}, which is not a crate in either workspace")
    return problems


def backend_uses(path):
    """The (line, name) places in a Rust file that name a getrandom back end
    or register one, in code or a string; whole comment lines aside."""
    try:
        with open(path, encoding="utf-8") as handle:
            text = handle.read()
    except (OSError, UnicodeDecodeError) as err:
        raise InputError(f"{path}: {err}") from err
    found = []
    for number, line in enumerate(text.splitlines(), start=1):
        if line.lstrip().startswith(("//", "/*", "*")):
            continue
        found.extend((number, match.group(0)) for match in GETRANDOM_BACKEND.finditer(line))
    return found


def source_problems(root, allowlist):
    """Every .rs file: unsafe code only where the list allows it, and a
    getrandom back end only in nowayos-entropy."""
    problems = []
    allowed = {}
    entropy_dirs = set()
    for entry in allowlist:
        for file in entry.get("files", []):
            allowed[os.path.normpath(file)] = entry["name"]
            if entry["name"] == ENTROPY_CRATE:
                # The crate's directory: its files' src/'s parent.
                entropy_dirs.add(os.path.dirname(os.path.dirname(os.path.normpath(file))) + os.sep)
    used = set()
    for directory, subdirs, files in os.walk(root):
        subdirs[:] = sorted(d for d in subdirs if d not in SKIP_DIRS and not d.startswith("."))
        for file in sorted(files):
            if not file.endswith(".rs"):
                continue
            path = os.path.join(directory, file)
            relative = os.path.normpath(os.path.relpath(path, root))
            if not any(relative.startswith(d) for d in entropy_dirs):
                for line, name in backend_uses(path):
                    problems.append(f"{relative}:{line}: `{name}`: a getrandom back end outside {ENTROPY_CRATE}")
            uses = unsafe_uses(path)
            if not uses:
                continue
            if relative in allowed:
                used.add(relative)
                continue
            for line, what in uses:
                problems.append(f"{relative}:{line}: {what} outside the approved-unsafe list")
    for relative in sorted(set(allowed) - used):
        problems.append(f"{relative}: on the approved-unsafe list but has no unsafe code any more: remove it from the list")
    return problems


def main():
    here = os.path.dirname(os.path.abspath(__file__))
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n", 1)[0])
    parser.add_argument("--root", default=os.path.dirname(here), help="nowayos repository")
    parser.add_argument("--allowlist", default=os.path.join(here, "unsafe-allowlist.toml"))
    parser.add_argument("--no-allowlist", action="store_true", help="no crate is approved for unsafe code")
    parser.add_argument("--miri-crates", metavar="WORKSPACE", help="print the miri = true crates of WORKSPACE")
    args = parser.parse_args()
    if tomllib is None:
        print("check-unsafe: needs Python 3.11 or later (tomllib); run it in the dev container", file=sys.stderr)
        return EXIT_ERROR
    try:
        allowlist = [] if args.no_allowlist else load_toml(args.allowlist).get("crate", [])
        if args.miri_crates:
            print(" ".join(e["name"] for e in allowlist if e.get("workspace") == args.miri_crates and e.get("miri")))
            return EXIT_PASS
        for entry in allowlist:
            if not entry.get("miri") and not entry.get("miri_exempt"):
                raise InputError(f"{args.allowlist}: {entry.get('name')!r} needs miri = true or a miri_exempt reason")
            if not entry.get("why"):
                raise InputError(f"{args.allowlist}: {entry.get('name')!r} needs a `why`")
        problems = lint_problems(args.root, allowlist) + source_problems(args.root, allowlist)
    except InputError as err:
        print(f"check-unsafe: {err}", file=sys.stderr)
        return EXIT_ERROR
    if problems:
        print("check-unsafe: FAIL", file=sys.stderr)
        for problem in problems:
            print(f"    {problem}", file=sys.stderr)
        return EXIT_FAIL
    if not allowlist:
        print(f"check-unsafe: PASS - no unsafe code in {args.root}, and every crate forbids it")
        return EXIT_PASS
    summary = "; ".join(f"{e['name']} ({', '.join(e['files'])})" for e in allowlist)
    print(f"check-unsafe: PASS - unsafe code only in the approved crates: {summary}")
    return EXIT_PASS


if __name__ == "__main__":
    sys.exit(main())
