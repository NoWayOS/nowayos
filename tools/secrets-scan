#!/usr/bin/env python3
# SPDX-License-Identifier: MIT OR Apache-2.0
"""The secrets scan: no key or credential in a repository or its history.

Usage:
    secrets-scan [--repo DIR] [--allow FILE]

Scans the git repository at DIR (default: the current directory) offline: it
reads the repository through git and nothing else.

* The tree: every file git tracks or would add (untracked and not ignored),
  as it is on disk.
* The history: every version of every file in every commit reachable from
  any ref - branches, tags, remote-tracking branches, the stash - and every
  commit message.

Each finding names the file and line - in the history, also the commits that
added that version of the file - and the rule it matched, with a fingerprint:
the first 16 hex digits of the sha256 of the matched text. The text itself is
never printed, so a CI log never repeats a secret. Text rules skip binary
files (a NUL byte in the first 8000 bytes, git's own test); the key-file rule
goes by file name, so it also finds binary key stores.

The allow file (FILE, default DIR/secrets-allow.toml; optional unless named)
lists reviewed false positives. Each [[allow]] entry names exactly one
finding - its `rule`, its `path` (or, for a commit message, its `commit`, the
full hash) and its `fingerprint` - and says why it is not a secret
(`reason`). An entry that matches no finding fails the scan, so the file never
outlives what it allows. A real secret is never allowed: remove it, rotate it,
and consider publishing a fresh history.

Exit status: 0 pass; 1 a finding, or an allow entry that matches nothing;
2 usage or input error - including a shallow clone, which lacks history the
scan must read. Python 3.11 or later (tomllib), standard library only; needs
git.
"""

import argparse
import hashlib
import math
import os
import re
import subprocess
import sys
import threading

try:
    import tomllib
except ModuleNotFoundError:  # Python before 3.11
    tomllib = None

EXIT_PASS = 0
EXIT_FAIL = 1
EXIT_ERROR = 2

DEFAULT_ALLOW = "secrets-allow.toml"
BINARY_PROBE = 8000
GITLINK_MODE = b"160000"
SHOWN_COMMITS = 3


class InputError(Exception):
    """The repository or the allow file could not be read."""


def fingerprint(text):
    """What identifies a finding without repeating it."""
    return hashlib.sha256(text).hexdigest()[:16]


def entropy(value):
    """Shannon entropy of `value`, in bits per byte."""
    counts = {}
    for byte in value:
        counts[byte] = counts.get(byte, 0) + 1
    return -sum(n / len(value) * math.log2(n / len(value)) for n in counts.values())


def random_looking(value):
    """A key rather than a word, a path or a placeholder: 16 or more
    characters, letters and digits both, 3.5 bits of entropy per character."""
    return (len(value) >= 16 and re.search(rb"[0-9]", value) is not None
            and re.search(rb"[A-Za-z]", value) is not None and entropy(value) >= 3.5)


PLACEHOLDER = re.compile(rb"(?i)^(?:[$<{%*.]|x{3,}$|(?:my)?(?:pass|passwd|password|pwd|secret|token|changeme)$)")


def not_placeholder(value):
    return PLACEHOLDER.search(value) is None


class Rule:
    """One kind of secret: a pattern for file contents (the group named
    `secret`, if any, is what the fingerprint covers; `accept` may refuse a
    match), or for file paths (`on_path`)."""

    def __init__(self, rule_id, what, pattern, keywords=(), accept=None, on_path=False, ignore_case=False):
        self.id = rule_id
        self.what = what
        self.regex = re.compile(pattern)
        self.keywords = keywords
        self.accept = accept
        self.on_path = on_path
        self.ignore_case = ignore_case


# A PEM, OpenSSH or PGP private key counts only with its body and end line,
# so text that merely names the header is not a finding.
RULES = (
    Rule("private-key", "a private key (PEM, OpenSSH or PGP)",
         rb"-----BEGIN[ A-Z0-9]{0,40}PRIVATE KEY(?: BLOCK)?-----[\s\S]{64,}?"
         rb"-----END[ A-Z0-9]{0,40}PRIVATE KEY(?: BLOCK)?-----",
         (b"PRIVATE KEY",)),
    Rule("putty-private-key", "a PuTTY private key",
         rb"PuTTY-User-Key-File-[0-9]+:[\s\S]{1,4000}?Private-Lines:", (b"PuTTY-User-Key-File",)),
    Rule("key-file", "a key store or private key file, by its name",
         r"(?i)(?:^|/)(?:[^/]+\.(?:p12|pfx|jks|keystore|ppk)|id_(?:rsa|dsa|ecdsa|ed25519))$", on_path=True),
    Rule("aws-access-key", "an AWS access key ID",
         rb"\b(?:A3T[A-Z0-9]|AKIA|ASIA|ABIA|ACCA)[A-Z2-7]{16}\b",
         (b"A3T", b"AKIA", b"ASIA", b"ABIA", b"ACCA"), accept=lambda value: b"EXAMPLE" not in value),
    Rule("azure-storage-key", "an Azure storage account key",
         rb"(?i)AccountKey=(?P<secret>[A-Za-z0-9+/]{86}==)", (b"accountkey=",), ignore_case=True),
    Rule("azure-client-secret", "a Microsoft Entra ID client secret",
         rb"(?:^|[\\'\"`\s>=:(,)])(?P<secret>[A-Za-z0-9_~.]{3}[0-9]Q~[A-Za-z0-9_~.-]{31,34})(?:$|[\\'\"`\s<),])",
         (b"Q~",)),
    Rule("github-token", "a GitHub token",
         rb"\b(?:gh[pousr]_[A-Za-z0-9]{36,255}|github_pat_[A-Za-z0-9_]{82})\b",
         (b"ghp_", b"gho_", b"ghu_", b"ghs_", b"ghr_", b"github_pat_")),
    Rule("gitlab-token", "a GitLab token", rb"\bglpat-[A-Za-z0-9_-]{20,}", (b"glpat-",)),
    Rule("slack-token", "a Slack token", rb"\bxox[abposr]-(?:[0-9]+-)?[A-Za-z0-9-]{10,}", (b"xox",)),
    Rule("slack-webhook", "a Slack webhook URL",
         rb"https://hooks\.slack\.com/(?:services|workflows|triggers)/[A-Za-z0-9+/]{20,}", (b"hooks.slack.com",)),
    Rule("google-api-key", "a Google API key", rb"\bAIza[0-9A-Za-z_-]{35}", (b"AIza",)),
    Rule("anthropic-api-key", "an Anthropic API key", rb"\bsk-ant-[a-z]+[0-9]{2}-[A-Za-z0-9_-]{20,}", (b"sk-ant-",)),
    Rule("openai-api-key", "an OpenAI API key",
         rb"\bsk-(?:[a-z]+-)?[A-Za-z0-9_-]{20,}T3BlbkFJ[A-Za-z0-9_-]{20,}", (b"T3BlbkFJ",)),
    Rule("npm-token", "an npm access token", rb"\bnpm_[A-Za-z0-9]{36}\b", (b"npm_",)),
    Rule("stripe-key", "a Stripe live key", rb"\b[rs]k_live_[A-Za-z0-9]{24,}", (b"k_live_",)),
    Rule("jwt", "a signed JSON Web Token",
         rb"\beyJ[A-Za-z0-9_-]{15,}\.eyJ[A-Za-z0-9_-]{15,}\.[A-Za-z0-9_-]{20,}", (b"eyJ",)),
    Rule("credentials-in-url", "a URL with a password in it",
         rb"\b[A-Za-z][A-Za-z0-9+.-]{1,20}://[^\s/:@'\"<>()\[\]]{1,64}:(?P<secret>[^\s/:@'\"<>()\[\]]{3,128})@[A-Za-z0-9.-]+",
         (b"://",), accept=not_placeholder),
    Rule("secret-assignment", "a random-looking value given to a password, secret, token or key",
         rb"(?i)(?:password|passwd|secret|token|api[_-]?key|access[_-]?key|auth[_-]?key|private[_-]?key)"
         rb"[A-Za-z0-9_-]*[\"']?\s*(?::=|=>|:|=)\s*[\"'](?P<secret>[^\"'\s]{16,})[\"']",
         (b"pass", b"secret", b"token", b"key"), accept=random_looking, ignore_case=True),
)
RULE_IDS = {rule.id for rule in RULES}


def scan(data, path):
    """Findings in one file's contents (`data`, bytes) at `path`:
    [(rule id, line, fingerprint)]."""
    found = []
    for rule in RULES:
        if rule.on_path and rule.regex.search(path):
            found.append((rule.id, 1, fingerprint(data)))
    if b"\0" in data[:BINARY_PROBE]:
        return found
    lowered = None
    for rule in RULES:
        if rule.on_path:
            continue
        if rule.ignore_case:
            if lowered is None:
                lowered = data.lower()
            haystack = lowered
        else:
            haystack = data
        if not any(keyword in haystack for keyword in rule.keywords):
            continue
        for match in rule.regex.finditer(data):
            secret = match.group("secret") if "secret" in rule.regex.groupindex else match.group(0)
            if rule.accept is not None and not rule.accept(secret):
                continue
            start = match.start("secret") if "secret" in rule.regex.groupindex else match.start()
            found.append((rule.id, data.count(b"\n", 0, start) + 1, fingerprint(secret)))
    return found


# ---- The repository, through git ----------------------------------------------

def git(repo, *args, stdin=None):
    try:
        result = subprocess.run(["git", "--no-optional-locks", "-C", repo, *args],
                                input=stdin, capture_output=True, check=False)
    except OSError as err:
        raise InputError(f"cannot run git: {err}") from err
    if result.returncode != 0:
        message = result.stderr.decode("utf-8", "replace").strip()
        raise InputError(f"git {args[0]} failed in {repo}: {message}")
    return result.stdout


def decode_path(raw):
    return raw.decode("utf-8", "surrogateescape")


def read_objects(repo, oids, kind):
    """Yield (oid, contents) for each object in `oids`, which must be `kind`."""
    if not oids:
        return
    try:
        process = subprocess.Popen(["git", "--no-optional-locks", "-C", repo, "cat-file", "--batch"],
                                   stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    except OSError as err:
        raise InputError(f"cannot run git: {err}") from err

    def feed():
        try:
            for oid in oids:
                process.stdin.write(oid + b"\n")
            process.stdin.close()
        except (BrokenPipeError, ValueError):
            pass

    writer = threading.Thread(target=feed, daemon=True)
    writer.start()
    try:
        for oid in oids:
            header = process.stdout.readline().split()
            if len(header) != 3 or header[0] != oid or header[1] != kind.encode():
                raise InputError(f"git cat-file: cannot read {kind} {oid.decode()} "
                                 f"({b' '.join(header).decode('utf-8', 'replace') or 'no answer'})")
            size = int(header[2])
            contents = process.stdout.read(size)
            process.stdout.read(1)  # the newline after each object
            if len(contents) != size:
                raise InputError(f"git cat-file: {oid.decode()} ended early")
            yield oid, contents
    finally:
        process.stdout.close()
        process.kill()  # done, or stopped early: either way, no more answers are wanted
        process.wait()
        writer.join()


def check_repository(repo):
    """The top of a git repository with its whole history, or InputError."""
    top = git(repo, "rev-parse", "--show-toplevel").decode().strip()
    if os.path.realpath(top) != os.path.realpath(repo):
        raise InputError(f"{repo} is not the top of a git repository (that is {top})")
    if git(repo, "rev-parse", "--is-shallow-repository").strip() == b"true":
        raise InputError(f"{repo} is a shallow clone, without the history this scan must read: "
                         "fetch all of it (git fetch --unshallow; in GitHub Actions, fetch-depth: 0)")


def tree_files(repo):
    """Yield (path, contents) for every file git tracks or would add."""
    listing = git(repo, "ls-files", "-z", "--cached", "--others", "--exclude-standard")
    for path in sorted({decode_path(raw) for raw in listing.split(b"\0") if raw}):
        full = os.path.join(repo, path)
        if os.path.islink(full) or not os.path.isfile(full):
            continue  # a symbolic link, a submodule, or deleted and not yet committed
        try:
            with open(full, "rb") as handle:
                yield path, handle.read()
        except OSError as err:
            raise InputError(f"cannot read {full}: {err}") from err


def history(repo):
    """(commits, versions): every commit reachable from any ref, newest
    first, and {blob: {path: [commits that added it there]}} for every
    version of every file they contain."""
    commits = git(repo, "rev-list", "--all").split()
    versions = {}
    if not commits:
        return commits, versions
    # Each commit against each parent (-m), the first against nothing (--root):
    # every version of every file enters the history in one of these diffs.
    raw = git(repo, "diff-tree", "--stdin", "-r", "-m", "--root", "--no-renames", "--no-abbrev", "-z",
              stdin=b"\n".join(commits) + b"\n")
    tokens = raw.split(b"\0")
    commit = None
    i = 0
    while i < len(tokens):
        token = tokens[i]
        if token.startswith(b":"):
            if i + 1 >= len(tokens):
                raise InputError("git diff-tree: an entry without a path")
            fields = token[1:].split(b" ")
            if len(fields) != 5:
                raise InputError(f"git diff-tree: unexpected entry {token.decode('utf-8', 'replace')}")
            new_mode, new_oid, status = fields[1], fields[3], fields[4][:1]
            if status in (b"A", b"M", b"T") and new_mode != GITLINK_MODE:
                paths = versions.setdefault(new_oid, {})
                added = paths.setdefault(decode_path(tokens[i + 1]), [])
                if commit not in added:
                    added.append(commit)
            i += 2
            continue
        if token:
            commit = token.strip()
        i += 1
    return commits, versions


def message_of(commit_object):
    """A raw commit object's message: everything after its headers."""
    return commit_object.partition(b"\n\n")[2]


# ---- The allow file ---------------------------------------------------------

def load_allow(path):
    """{(rule, kind, where, fingerprint): entry number} from the allow file."""
    try:
        with open(path, "rb") as handle:
            document = tomllib.load(handle)
    except (OSError, tomllib.TOMLDecodeError) as err:
        raise InputError(f"cannot read {path}: {err}") from err
    extra = set(document) - {"allow"}
    if extra:
        raise InputError(f"{path}: unknown table {', '.join(sorted(extra))} (only [[allow]] entries)")
    entries = document.get("allow", [])
    if not isinstance(entries, list):
        raise InputError(f"{path}: allow must be a list of [[allow]] entries")
    allowed = {}
    for number, entry in enumerate(entries, 1):
        where = f"{path}: entry {number}"
        if not isinstance(entry, dict):
            raise InputError(f"{where} is not a table")
        unknown = set(entry) - {"rule", "path", "commit", "fingerprint", "reason"}
        if unknown:
            raise InputError(f"{where}: unknown key {', '.join(sorted(unknown))}")
        rule = entry.get("rule")
        if rule not in RULE_IDS:
            raise InputError(f"{where}: rule {rule!r} is not one of {', '.join(sorted(RULE_IDS))}")
        if ("path" in entry) == ("commit" in entry):
            raise InputError(f"{where}: name the finding's file (path) or, for a commit message, its commit - one of them")
        kind = "path" if "path" in entry else "commit"
        location = entry[kind]
        if not isinstance(location, str) or not location:
            raise InputError(f"{where}: {kind} must be a non-empty string")
        if kind == "commit" and not re.fullmatch(r"[0-9a-f]{40}|[0-9a-f]{64}", location):
            raise InputError(f"{where}: commit must be the full hash")
        mark = entry.get("fingerprint")
        if not isinstance(mark, str) or not re.fullmatch(r"[0-9a-f]{16}", mark):
            raise InputError(f"{where}: fingerprint must be the 16 hex digits the scan printed")
        reason = entry.get("reason")
        if not isinstance(reason, str) or not reason.strip():
            raise InputError(f"{where}: give the reason this is not a secret")
        key = (rule, kind, location, mark)
        if key in allowed:
            raise InputError(f"{where} repeats entry {allowed[key]}")
        allowed[key] = number
    return allowed


# ---- The scan -----------------------------------------------------------------

def short(commit):
    return commit.decode()[:12]


def main():
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n", 1)[0])
    parser.add_argument("--repo", default=".", help="the repository to scan (default: the current directory)")
    parser.add_argument("--allow", help=f"the reviewed allow file (default: REPO/{DEFAULT_ALLOW}, if present)")
    args = parser.parse_args()
    if tomllib is None:
        print("secrets-scan: needs Python 3.11 or later (tomllib); run it in the dev container", file=sys.stderr)
        return EXIT_ERROR
    repo = args.repo
    allow_path = args.allow if args.allow else os.path.join(repo, DEFAULT_ALLOW)
    # Each finding: (sort key, where, rule, fingerprint, how found, allow key).
    findings = []
    try:
        check_repository(repo)
        allowed = load_allow(allow_path) if args.allow or os.path.exists(allow_path) else {}
        tree_count = 0
        for path, data in tree_files(repo):
            tree_count += 1
            for rule, line, mark in scan(data, path):
                findings.append(((0, path, line, rule), f"{path}:{line}", rule, mark, "in the tree",
                                 (rule, "path", path, mark)))
        commits, versions = history(repo)
        age = {commit: index for index, commit in enumerate(commits)}
        for oid, data in read_objects(repo, sorted(versions), "blob"):
            for path, added in versions[oid].items():
                found = scan(data, path)
                if not found:
                    continue
                added = sorted(added, key=lambda commit: -age.get(commit, 0))  # oldest first
                shown = ", ".join(short(commit) for commit in added[:SHOWN_COMMITS])
                more = f" and {len(added) - SHOWN_COMMITS} more" if len(added) > SHOWN_COMMITS else ""
                how = f"in the history, added by commit{'s' if len(added) > 1 else ''} {shown}{more}"
                for rule, line, mark in found:
                    findings.append(((1, path, line, rule, shown), f"{path}:{line}", rule, mark, how,
                                     (rule, "path", path, mark)))
        for commit, data in read_objects(repo, commits, "commit"):
            for rule, line, mark in scan(message_of(data), ""):
                findings.append(((2, commit, line, rule), f"commit {short(commit)}, message line {line}", rule, mark,
                                 "in the history", (rule, "commit", commit.decode(), mark)))
    except InputError as err:
        print(f"secrets-scan: {err}", file=sys.stderr)
        return EXIT_ERROR

    what = {rule.id: rule.what for rule in RULES}
    used = set()
    reported = []
    for _, where, rule, mark, how, key in sorted(findings):
        if key in allowed:
            used.add(key)
        else:
            reported.append(f"{where}: {rule}, {what[rule]} [fingerprint {mark}] - {how}")
    stale = sorted(number for key, number in allowed.items() if key not in used)
    if reported or stale:
        print(f"secrets-scan: FAIL - {os.path.realpath(repo)}", file=sys.stderr)
        for text in reported:
            print(f"    {text}", file=sys.stderr)
        for number in stale:
            print(f"    {allow_path}: entry {number} matches no finding: remove it", file=sys.stderr)
        if reported:
            print("A finding is a secret until a person shows otherwise: remove it, rotate it, and consider "
                  "publishing a fresh history. A reviewed false positive goes in the allow file as an [[allow]] entry naming its "
                  "rule, path (or commit), fingerprint and the reason.", file=sys.stderr)
        return EXIT_FAIL
    print(f"secrets-scan: PASS - {os.path.realpath(repo)}: {tree_count} files in the tree; "
          f"{len(versions)} file versions and {len(commits)} commit messages in the history, from every ref; "
          f"{len(used)} allowed finding{'' if len(used) == 1 else 's'}"
          f"{f' ({allow_path})' if allowed else ''}")
    return EXIT_PASS


if __name__ == "__main__":
    sys.exit(main())
