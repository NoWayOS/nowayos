# Lines in a step's output that state its result, and what varies between
# runs of one commit taken out of them: timings, the container's paths, and
# the secrets scan's history counts, which grow with every ref the clone
# holds (other branches), not with the commit.
RESULT = re.compile(r"^(?:[a-z0-9-]+: (?:PASS|FAIL)\b|notice: |advisories |sbom: |image-sbom: |demo: |"
                    r"Ran \d+ tests?|OK$|FAILED|test result: |error[:\[])")
VARYING = ((re.compile(r"; last after [0-9.]+s"), ""), (re.compile(r" in [0-9.]+s\b"), ""),
           (re.compile(r"finished in [0-9.]+s"), "finished"), (re.compile(r"/work/"), ""),
           (re.compile(r"\d+ file versions and \d+ commit messages in the history, from every ref"),
            "every file version and commit message in the history, from every ref"))

