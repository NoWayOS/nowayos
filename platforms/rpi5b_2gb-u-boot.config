# U-Boot settings for booting a Microkit image on the Raspberry Pi 5, merged
# onto U-Boot's rpi_arm64_defconfig by `make uboot`. After merging,
# `make uboot` fails unless every line below is in the final .config.

# Autoboot the image on the SD card's boot partition with the Microkit 2.3.1
# manual's commands (its "Raspberry Pi 5B" section): load it at 0x10000000,
# where the loader is linked, and jump to it. A saved environment (uboot.env
# on the card) overrides bootcmd: delete it to get this one back.
#
# Only the stop word, typed within the delay, stops at the U-Boot prompt
# instead: with no probe attached, the debug UART's floating receive
# line reads as junk, and any key would stop a demo at U-Boot. Not a secret -
# it keeps noise out, not people; tools/pi-run and the workspace's
# u-boot-pause type it. Neither Ctrl-C nor any other key stops autoboot.
CONFIG_AUTOBOOT=y
CONFIG_AUTOBOOT_KEYED=y
CONFIG_AUTOBOOT_FLUSH_STDIN=y
CONFIG_AUTOBOOT_PROMPT="Type stopboot within %d seconds to stop autoboot\n"
# CONFIG_AUTOBOOT_ENCRYPTION is not set
CONFIG_AUTOBOOT_STOP_STR="stopboot"
# CONFIG_AUTOBOOT_KEYED_CTRLC is not set
CONFIG_BOOTDELAY=3
CONFIG_USE_BOOTCOMMAND=y
CONFIG_BOOTCOMMAND="fatload mmc 0 0x10000000 loader.img; go 0x10000000"

# Host tools only, not u-boot.bin: no FIT-image signing, no EFI capsules and
# no Marvell kwbimage support (which would turn OpenSSL back on), so the build
# needs neither OpenSSL nor GnuTLS in the dev container.
# CONFIG_TOOLS_LIBCRYPTO is not set
# CONFIG_TOOLS_KWBIMAGE is not set
# CONFIG_TOOLS_MKEFICAPSULE is not set
